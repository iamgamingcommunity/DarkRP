 <!-- | DarkRP F4 Job Menu | -->

<div class="job-f4-menu @(IsF4JobMenuOpen ? "" : "hide")">
    <!-- DarkRP F4 Job Menu RIGHT SIDE -->
<div class="job-infoHolder">

    <div class="job-infodesc">
        <h3>Job Description</h3>

        @if (SelectedJob != null)
        {
            <p>@SelectedJob.Description</p>
        }
        else
        {
            <p class="job-placeholder">
                Select a job to see its description.
            </p>
        }
    </div>

    <div class="job-infosweps-scroll">
        <h3>Job Sweps</h3>

        @if (SelectedJob != null && SelectedJob.StartingEquipment != null && SelectedJob.StartingEquipment.Count > 0)
        {
            <ul>
                @foreach (var swep in SelectedJob.StartingEquipment)
                {
                    <li>@swep.EquipmentName</li>
                }
            </ul>
        }
        else
        {
            <p class="job-placeholder">
                No equipment information available.
            </p>
        }
    </div>

    <button class="become-job"
            disabled="@(TrySelectJob == null)"
            onclick="@(() => TryBecomeJob(PlayerInfo, OldSelectedJob))">
        <div class="becomejobtitle">
            @(SelectedJob != null ? "Become Job" : "Select a Job")
        </div>
    </button>
</div>

