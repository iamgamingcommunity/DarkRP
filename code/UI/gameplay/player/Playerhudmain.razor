    <!-- DarkRP F4 Job Menu LEFT SIDE -->
<div class="Misc-menu">
    @foreach ( var category in CategoryResource.All.Where( c => c.IsJobCategory ) )
    {
        var categoryPickupables = Pickupables
            .Where( p =>
                !string.IsNullOrWhiteSpace( p.F4BuyMenuCategory ) &&
                p.F4BuyMenuCategory == category.Name
            )
            .ToList();

        // If this category has no items, don't render it at all
        if ( !categoryPickupables.Any() )
            continue;

        <div class="category">
            <button class="category-button"
                    style="background-color:@category.Color"
                    onclick="@(() => ToggleCategory(category))">
                @category.Name
            </button>

            <div class="Misc-list @(IsOpen(category) ? "open" : "")">
                @foreach ( var item in categoryPickupables )
                {
                    <button class="Misc-button">

                        <span>@item.EquipmentName</span>

                        <div class="Miscbottomborder"
                             style="background-color:@category.Color">
                        </div>

                    </button>
                }
            </div>
        </div>
    }
</div>


</div>

