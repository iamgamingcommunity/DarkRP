        //Select Job Button, this is NOT the 'Become Job Button'
    void SelectJob(JobResource job, CategoryResource.JobCategoryInfoStructMain jobInfo)
    {
        if (jobInfo.JobSlotsTaken >= job.MaxPlayersAllowedOnJob)
        {
            Log.Info($"Job {job.Title} is full ({jobInfo.JobSlotsTaken}/{job.MaxPlayersAllowedOnJob})");
            return;
        }

        SelectedJob = job;
        jobInfo.JobSlotsTaken++;

        Log.Info($"Selected job: {job.Title}, {jobInfo.JobSlotsTaken}/{job.MaxPlayersAllowedOnJob}");
    }

    void BecomeJob()
    {
        if (SelectedJob == null) return;
        // DarkRP logic here
        GraphBecomeJob?.Invoke(SelectedJob);
        Log.Info($"Becoming job: {SelectedJob.Title}");
    }

