 <!-- Chat Menu UI -->
<chat-menu-input class="@(IsDefaultDarkRPChatOpen ? "" : "hide")">
 	<div class="chat-input">
    <TextEntry @ref="DefaultDarkRPChatMessage" placeholder="Enter Chat Message..." />
    <button onclick="@(() => {GraphOpenChatSettings?.Invoke(); })">Send Chat</button>
	</div>
</chat-menu-input>



 <!-- Arrest UI That Pops up when Arrested Logic Is Triggered -->
<arrested-ui class="@(IsArrested ? "" : "hide")">
	<div class="arresteduibackground">
					<div class="arresteduitext">
						Released in <span class="Jailtime">@JailTime Seconds</span>
					</div>
                    </div>
</arrested-ui>
 <!-- F4Menu Base UI -->
<f4menu-ui class="@(IsF4MenuOpen ? "" : "hide")">
	<div class="f4menubackground">
				<div class="F4MenuButtonHolder">
	                <div class="F4Button">
					    <div class="F4ButtonText">
						Jobs
                        </div>
					</div>

					<div class="F4Button">
					    <div class="F4ButtonText">
						Miscellaneous
                        </div>
					</div>

					<div class="F4Button">
					    <div class="F4ButtonText">
						Shipments
                        </div>
					</div>

                    <div class="F4Button">
					    <div class="F4ButtonText">
						Weapons
                        </div>
					</div>

                    <div class="F4Button">
					    <div class="F4ButtonText">
						Ammo
                        </div>
					</div>

					<div class="F4Button">
					    <div class="F4ButtonText">
						Vehicles
                        </div>
					</div>
                </div>
                 <!-- F4 Menu Exit Button -->
                <div class="F4ExitButton" onclick="@(() => {GraphCloseF4Menu?.Invoke(); })">
				</div>


    <!-- DarkRP F4 Job Menu RIGHT SIDE -->
<div class="job-infoHolder">

    <div class="job-infodesc">
        <h3>Job Description</h3>

        @if (SelectedJob != null)
        {
            <p>@SelectedJob.Description</p>
        }
        else
        {
            <p class="job-placeholder">
                Select a job to see its description.
            </p>
        }
    </div>

    <div class="job-infosweps-scroll">
        <h3>Job Sweps</h3>

        @if (SelectedJob != null && SelectedJob.StartingEquipment != null && SelectedJob.StartingEquipment.Count > 0)
        {
            <ul>
                @foreach (var swep in SelectedJob.StartingEquipment)
                {
                    <li>@swep.EquipmentName</li>
                }
            </ul>
        }
        else
        {
            <p class="job-placeholder">
                No equipment information available.
            </p>
        }
    </div>

    <button class="become-job"
            disabled="@(SelectedJob == null)"
            onclick="@(() => {BecomeJob(); })">
        <div class="becomejobtitle">
            @(SelectedJob != null ? "Become Job" : "Select a Job")
        </div>
    </button>

</div>

