	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash()
{
    int hash = 17;

    hash = hash * 31 + (MyStringValue?.GetHashCode() ?? 0);
    @* hash = hash * 31 + Player.ActiveSlot.GetHashCode();
    hash = hash * 31 + Player.HotBarSlots.Count.GetHashCode(); *@
    hash = hash * 31 + JailTime.GetHashCode();
    hash = hash * 31 + IsArrested.GetHashCode();
    hash = hash * 31 + IsF4MenuOpen.GetHashCode();

    hash = hash * 31 + IsF4JobMenuOpen.GetHashCode();
    hash = hash * 31 + IsF4MiscMenuOpen.GetHashCode();
    hash = hash * 31 + IsF4ShipmentsMenuOpen.GetHashCode();
    hash = hash * 31 + IsF4WeaponsMenuOpen.GetHashCode();
    hash = hash * 31 + IsF4AmmoMenuOpen.GetHashCode();
    hash = hash * 31 + IsF4VehiclesMenuOpen.GetHashCode();
    hash = hash * 31 + IsDefaultDarkRPChatOpen.GetHashCode();

    if (SelectedJob != null)
        hash = hash * 31 + SelectedJob.GetHashCode();



    @* foreach (var slot in Player.HotBarSlots)
    {
        hash = System.HashCode.Combine(hash, IsDefaultDarkRPChatOpen);
    } *@

    return hash;
}
	
