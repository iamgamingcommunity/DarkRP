 <!-- Chat Menu UI -->
<chat-menu-input class="@(IsDefaultDarkRPChatOpen ? "" : "hide")">
 	<div class="chat-input">
    <TextEntry @ref="DefaultDarkRPChatMessage" placeholder="Enter Chat Message..." />
    <button onclick="@(() => {GraphOpenChatSettings?.Invoke(); })">Send Chat</button>
	</div>
</chat-menu-input>



 <!-- Arrest UI That Pops up when Arrested Logic Is Triggered -->
<arrested-ui class="@(IsArrested ? "" : "hide")">
	<div class="arresteduibackground">
					<div class="arresteduitext">
						Released in <span class="Jailtime">@JailTime Seconds</span>
					</div>
                    </div>
</arrested-ui>
 <!-- F4Menu Base UI -->
<f4menu-ui class="@(IsF4MenuOpen ? "" : "hide")">
	<div class="f4menubackground">
				<div class="F4MenuButtonHolder">
	                <div class="F4Button">
					    <div class="F4ButtonText">
						Jobs
                        </div>
					</div>

					<div class="F4Button">
					    <div class="F4ButtonText">
						Miscellaneous
                        </div>
					</div>

					<div class="F4Button">
					    <div class="F4ButtonText">
						Shipments
                        </div>
					</div>

                    <div class="F4Button">
					    <div class="F4ButtonText">
						Weapons
                        </div>
					</div>

                    <div class="F4Button">
					    <div class="F4ButtonText">
						Ammo
                        </div>
					</div>

					<div class="F4Button">
					    <div class="F4ButtonText">
						Vehicles
                        </div>
					</div>
                </div>
                 <!-- F4 Menu Exit Button -->
                <div class="F4ExitButton" onclick="@(() => {GraphCloseF4Menu?.Invoke(); })">
				</div>




 <div class="JobcategoryMenu">
 <!-- LEFT SIDE -->
@foreach (var category in JobCatagory)
{
    <div class="jobcategory-block">
        <div class="category-header" style="background-color:@category.Color">
            @category.Name
        </div>

        <div class="jobs-list">
            @foreach (var job in category.JobsInCatagory)
            {
                <div class="job-entry" tabindex="0" onclick="@(() => {SelectJob(job); })">
                    <div class="job-name">@job.Title</div>
                                     @if (job.JobImage != null)
                    {
                        <img src="@job.JobImage" alt="@job.Title" class="job-icon" />
                    }
                </div>
            }
        </div>
    </div>
}

    <!-- RIGHT SIDE @<h2>@SelectedJob.Title</h2>@ -->
<div class="job-infoHolder">
    <div class="job-infodesc">
        @if (SelectedJob != null)
        {
            
            <p>Job Description: @SelectedJob.Description</p>
        

        }
         </div>
    <div class="job-infosweps">
        @if (SelectedJob != null && SelectedJob.StartingEquipment != null)
        {
            <p>Job Sweps:</p>
            <ul>
                @foreach (var swep in SelectedJob.StartingEquipment)
                {
                    <li>@swep.EquipmentName</li>
                }
            </ul>
        }
         </div>




            <button class="become-job"
                    @onclick="() => BecomeJob(SelectedJob)">
                <div class="becomejobtitle">Become Job</div>
            </button>

            
        </div>

</div>
</f4menu-ui>


@code
{







    CategoryResource ExpandedCategory;




    List<CategoryResource> Categories = new();
    List<JobResource> Jobs = new();

    void ToggleCategory(CategoryResource category)
    {
        ExpandedCategory = ExpandedCategory == category ? null : category;
    }
    
    
    //Selected Job Info
    [Property] JobResource SelectedJob;

    void SelectJob(JobResource job)
    {
        SelectedJob = job;
        Log.Info($"Selected job: {job.Title}");
    }



    void BecomeJob(JobResource job)
    {
        // DarkRP logic here
        Log.Info($"Becoming job: {job.Title}");
    }




	//Actions Graphs For Default DarkRP Chat
	public delegate void ActionGraphOpenChatSettings();
	[Property, Feature("Player Hud Info")]
	public ActionGraphOpenChatSettings GraphOpenChatSettings { get; set; }

	public delegate void ActionGraphSendChat(GameObject PlayerController, string ChatMessage);
	[Property, Feature("Player Hud Info")]
	public ActionGraphSendChat GraphSendChat{ get; set; }

	public delegate void ActionGraphCloseF4Menu();
	[Property, Feature("Player Hud Info")]
	public ActionGraphCloseF4Menu GraphCloseF4Menu { get; set; }



  	[Property] public List<CategoryResource> JobCatagory {get; set;}














	//UI Visability Vars for Default DarkRP Chat
    public bool IsDefaultDarkRPChatOpen {get; set;}
    public TextEntry DefaultDarkRPChatMessage {get; set;}





    //F4 Menu UI Vars
    public bool IsF4MenuOpen {get; set;}
   
    public bool JobsF4TabRemoved {get; set;}
    public bool ShipmentsF4TabRemoved {get; set;}
	public bool MiscellaneousF4TabRemoved {get; set;}
	public bool WeaponsF4TabRemoved {get; set;}
	public bool AmmoF4TabRemoved {get; set;}
	public bool VehiclesF4TabRemoved {get; set;}





    //Arrested UI Vars

	public int JailTime {get; set;}
	public bool IsArrested {get; set;}


	public void SendDefaultDarkRPChatMessage(GameObject PlayerController, string ChatMessage)
	{
		GraphSendChat?.Invoke(PlayerController, ChatMessage);
	}










	[Property] public DarkrpPlayerInfo Player { get; set; }

    private bool IsActiveSlot(int index)
    {
        return Player.ActiveSlot == index;
    }

	[Property, TextArea] public string MyStringValue { get; set; } = "Hello World!";



	void CloseF4Menu()
	{
	 	GraphCloseF4Menu?.Invoke();
	}





	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash()
{
    int hash = System.HashCode.Combine(MyStringValue, Player.ActiveSlot, Player.HotBarSlots.Count, JailTime, IsArrested, IsF4MenuOpen);

    foreach (var slot in Player.HotBarSlots)
    {
        hash = System.HashCode.Combine(hash, IsDefaultDarkRPChatOpen);
    }

    return hash;
}
	
}