{




public Playerhudmain()
{
    OpenCategories = new HashSet<CategoryResource>(
        CategoryResource.All.Where(c => c.IsJobCategory)
    );

    CategoryResource.OnCategoriesLoaded += () =>
    {
        foreach (var cat in CategoryResource.All.Where(c => c.IsJobCategory))
        {
            OpenCategories.Add(cat);
        }
    };
}





HashSet<CategoryResource> OpenCategories = new HashSet<CategoryResource>(
    CategoryResource.All.Where(c => c.IsJobCategory)
);

void ToggleCategory( CategoryResource category )
{
    if ( OpenCategories.Contains( category ) )
        OpenCategories.Remove( category );
    else
        OpenCategories.Add( category );
}

bool IsOpen( CategoryResource category )
{
    return OpenCategories.Contains( category );
}






    CategoryResource ExpandedCategory;




    List<CategoryResource> Categories = new();
    List<JobResource> Jobs = new();

    
    
    //Selected Job Info
    [Property] JobResource SelectedJob;

    void SelectJob(JobResource job)
    {
        SelectedJob = job;
        Log.Info($"Selected job: {SelectedJob.Title}");
    }



    void BecomeJob()
    {
        if (SelectedJob == null) return;
        // DarkRP logic here
        GraphBecomeJob?.Invoke(SelectedJob);
        Log.Info($"Becoming job: {SelectedJob.Title}");
    }




