@{
    // Get the component from this prefab
    @* var playerInfo = this.GetComponent<DarkrpPlayerInfo>();
    var usergroup = playerInfo?.Usergroup ?? ""; *@
}

<div class="job-menu">
    @foreach (var category in JobCategory)
    {
        // Skip empty categories
        if (category.JobCategoryInfo == null || !category.JobCategoryInfo.Any())
            continue;

        // Filter jobs by usergroup
        var allowedJobs = category.JobCategoryInfo.Where(jobInfo => jobInfo.JobsInCategory != null )
            .ToList();

        // Skip category if no allowed jobs
        if (!allowedJobs.Any())
            continue;



      

        <div class="category">
            <button class="category-button"
                    style="background-color:@category.Color"
                    onclick="@(() => ToggleCategory(category))">
                @category.Name
            </button>

            <div class="job-list @(IsOpen(category) ? "open" : "")">
                @foreach (var jobInfo in allowedJobs)
                {
                    
                    var job = jobInfo.JobsInCategory;

                    var matchingSlot = JobManagerVar?.SyncedJobList?
                        .FirstOrDefault(x => x.JobCommandName == job.JobCommandName);

                    int currentSlots = matchingSlot?.JobSlotAmount ?? 0;

                    <button class="job-button"
                            onclick="@(() => TrySelectJob(job, jobInfo))">
                        <ul>
                            @if (job.JobImage != null)
                            {
                                <Image Texture="@job.JobImage" class="job-img" />
                            }
                        </ul>
                        <span>@job.Title</span>
                        <div class="jobcounter">

                            @currentSlots/@job.MaxPlayersAllowedOnJob
                        </div>
                        <div class="jobbottomborder"
                             style="background-color:@job.Color">
                        </div>
                    </button>
                }
            </div>
        </div>
    }
</div>



</div>

