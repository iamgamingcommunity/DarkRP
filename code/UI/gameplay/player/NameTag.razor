@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root class="@(Network.IsProxy ? "" : "hidden")">
	<div class="title">@(DisplayName)</div>
</root>

@code
{


	[Property, Feature("Basic DarkRP Info"), Group("Basic DarkRP Info")] public string DisplayName { get; set; }


	protected override int BuildHash() => System.HashCode.Combine( DisplayName );
}