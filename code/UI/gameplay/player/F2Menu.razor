					<div class="buttontext">
						Edit Door Groups
					</div>
				</div>
		</div>
	</div>

		<div class="buttontextdoor">
			Door Options
		</div>
</f2menudoor-owner>

<editdoorgroupbuttons-menu class="@(IsInF2MenuEditDoorGroupsUI  ? "" : "hide")">
<div class="doorowneroptions">
			<div class="buttonholderowner">
