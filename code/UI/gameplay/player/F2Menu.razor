					</div>
					</div>
				<div class="buttonbackground"onclick=@ShowDoorGroupsRemoveButton>
					<div class="buttontext">
						Remove
					</div>
					</div>
</div>
</editdoorgroupbuttons-doorgroupsmenu>

<editdoorgroupbuttons-jobsmenu class="@(IsInJobsUIButton  ? "" : "hide")">
<div class="doorowneroptions">
			<div class="buttonholderowner">
				<div class="buttonbackground"onclick=@ShowJobsAddButton>
					<div class="buttontext">
						Add
					</div>
					</div>
				<div class="buttonbackground"onclick=@ShowJobsRemoveButton>
					<div class="buttontext">
						Remove
					</div>
					</div>
</div>
</editdoorgroupbuttons-jobsmenu>


<onlineaplayers-list class="@(IsInF2MenuAddFriendButton  ? "" : "hide")">
    <div class="job-cardholder">
        @if (PlayerDataList != null && PlayerDataList.Count > 0)
        {
            @foreach (var player in PlayerDataList)
            {
                <div class="job-card" onclick="@(() => { GraphOnlinePlayerButton?.Invoke(player); })">
                    <div class="job-title">@player.PlayerID</div>
                    <!--
                        If you want more info from DarkRPPlayerInfo, you can do:
                        <div class="job-description">@player.DarkRPPlayerInfo.SomeProperty</div>
                    -->
                </div>
            }
        }
        else
        {
            <div class="loading">No players online...</div>
        }
    </div>
</onlineaplayers-list>

<playerfriendsaddedtodoor-list class="@(IsInF2MenuRemoveFriendButton  ? "" : "hide")">
    <div class="job-cardholder">
        @if (PlayerFriendsAddedToDoorList != null && PlayerFriendsAddedToDoorList.Count > 0)
        {
            @foreach (var player in PlayerFriendsAddedToDoorList)
            {
				var currentPlayer = player; <!-- capture here -->
                <div class="job-card" onclick="@(() => { GraphRemoveFriendFromDoor?.Invoke(currentPlayer); })">
                    <div class="job-title">@currentPlayer.PlayerID</div>
                    <!--
                        If you want more info from DarkRPPlayerInfo, you can do:
                        <div class="job-description">@player.DarkRPPlayerInfo.SomeProperty</div>
                    -->
                </div>
            }
        }
        else
        {
            <div class="loading">No players online...</div>
        }
    </div>
</playerfriendsaddedtodoor-list>

<doorgroup-list class="@(IsInDoorGroupAddUIButton ? "" : "hide")">
    <div class="job-cardholder">
	@if (AllNonSelectedDoorGroupCategory != null && AllNonSelectedDoorGroupCategory.Count > 0)
    {
        @foreach ( var doorgc in AllNonSelectedDoorGroupCategory )
        {
		
            <div class="job-card" onclick="@(() => { GraphAddSelectedDoorGroup?.Invoke(doorgc); })">
                <div class="job-title">@doorgc.Title</div>
            </div>
		
        }
    }
    else
    {
        <div class="loading">No Door Groups Selected...</div>
    }
	</div>
</doorgroup-list>

<doorremovegroup-list class="@(IsInDoorGroupRemoveUIButton ? "" : "hide")">
    <div class="job-cardholder">
	@if (AllSelectedDoorGroupCategory != null && AllSelectedDoorGroupCategory.Count > 0)
    {
        @foreach ( var doorgc in AllSelectedDoorGroupCategory )
        {
		
            <div class="job-card" onclick="@(() => { GraphRemoveSelectedDoorGroup?.Invoke(doorgc); })">
                <div class="job-title">@doorgc.Title</div>
            </div>
		
        }
    }
    else
    {
        <div class="loading">No Door Groups Selected...</div>
    }
	</div>
</doorremovegroup-list>


