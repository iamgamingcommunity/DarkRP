</div>
</editdoorgroupbuttons-menu>

<editdoorgroupbuttons-doorgroupsmenu class="@(IsInDoorGroupUIButton  ? "" : "hide")">
<div class="doorowneroptions">
			<div class="buttonholderowner">
				<div class="buttonbackground"onclick=@ShowDoorGroupsAddButton>
					<div class="buttontext">
