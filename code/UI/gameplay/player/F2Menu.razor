@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox
@using NetworkManager; 

<root class="@(IsShowingF2Menu ? "" : "hide")">
<div class="f2nonownermenu @(IsInDoorNonOwnerMenu ? "" : "hide")">
	<div class="options">
			<div class="buttonholder">
				<div class="buttonbackground"onclick=@OpenSetDoorTitleMenu>
					<div class="buttontext">
						Set Door Title
					</div>
				</div>
				<div class="buttonbackground"onclick=@DisallowOwnership>
					<div class="buttontext">
						@DisallowOwnershipTitle
					</div>
				</div>
				<div class="buttonbackground" onclick=@BuyDoor>
					<div class="buttontext">
						Buy Door
					</div>
				</div>
				<div class="buttonbackground"onclick=@EditDoorGroup>
					<div class="buttontext">
						Edit Door Groups
					</div>
				</div>
		</div>
	</div>

		<div class="buttontextdoor">
			Door Options
		</div>



<div class="CloseF2MenuButton @(IsInF2MenuEditDoorGroupsUI ? "" : "hide")" onclick="@(() => {GraphCloseF2MenuButton?.Invoke(); })">
</div>

</div>



<setcustomtitle-menu class="door-title-holder @(IsInDoorCustomTitleMenu ? "" : "hide")">
 	<div class="door-title-input">
    <TextEntry @ref="DoorCustomTitleEntry" placeholder="Enter door title..." />
    <button onclick="@(() => {GraphSetDoorTitleButton?.Invoke(); })">Set Title</button>
	</div>
</setcustomtitle-menu>

    <!-- @foreach ( var job in Jobs )
    {
        <div class="job-card">
            <div class="job-title">@job.Title</div>
            <div class="job-salary">$@job.Salary</div>
            <div class="job-description">@job.Description</div>
        </div>
    } -->


<job-list class="@(IsInJobsAddUIButton ? "" : "hide")">
    <div class="job-cardholder">
	@if (Jobs != null && Jobs.Count > 0)
    {
        @foreach ( var job in Jobs )
        {
		
            <div class="job-card" onclick="@(() => { GraphAddSelectedJobFromDoorButton?.Invoke(job); })">
                <div class="job-title">@job.Title</div>
            </div>
		
        }
    }
    else
    {
        <div class="loading">No Jobs Selected...</div>
    }
	</div>
</job-list>


<jobremove-list class="@(IsInJobsRemoveUIButton ? "" : "hide")">
    <div class="job-cardholder">
	@if (SelectedDoorJobs  != null && SelectedDoorJobs .Count > 0)
    {
        @foreach ( var job in SelectedDoorJobs )
        {
		
            <div class="job-card" onclick="@(() => { GraphRemoveSelectedJobFromDoorButton?.Invoke(job); })">
                <div class="job-title">@job.Title</div>
            </div>
		
        }
    }
    else
    {
        <div class="loading">No Jobs Added...</div>
    }
	</div>
</jobremove-list>




</root>

