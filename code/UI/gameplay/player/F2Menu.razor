private void RefreshDoorGroups()
{
    AllNonSelectedDoorGroupCategory = DoorGroupCategoryResource.All.ToList();
    Log.Info($"[F2Menu] Loaded {AllNonSelectedDoorGroupCategory.Count} Door Groups");
    StateHasChanged(); // rebuild UI
}




  protected override void OnStart()
    {
        // Subscribe to the load event so we update when jobs finish loading
        JobResource.OnJobsLoaded += RefreshJobs;

        // In case jobs were already loaded
        RefreshJobs();

		// Door Groups
    	DoorGroupCategoryResource.OnDoorGroupCategoryResourceLoaded += RefreshDoorGroups;
    	RefreshDoorGroups(); // in case they are already loaded
    }

    private void RefreshJobs()
    {
        Jobs = JobResource.All.ToList();
        StateHasChanged(); // Force rebuild
    }








