@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root class="@(IsShowingF2Menu ? "" : "hide")">
	<div class="options">
		<!-- <div class="buttonbackgroundbackplate"> -->
				<!-- <div class="inner">
					<div class="fill" style="width:">

		</div>	
				</div> -->
			<div class="buttonholder">
				<div class="buttonbackground"onclick=@DisallowOwnership>
					<div class="buttontext">
						Disallow Ownership
					</div>
				</div>
				<div class="buttonbackground" onclick=@BuyDoor>
					<div class="buttontext">
						Buy Door
					</div>
				</div>
				<div class="buttonbackground"onclick=@EditDoorGroup>
					<div class="buttontext">
						Edit Door Groups
					</div>
				</div>
		<!-- </div> -->
		</div>
	</div>


    <!-- @foreach ( var job in Jobs )
    {
        <div class="job-card">
            <div class="job-title">@job.Title</div>
            <div class="job-salary">$@job.Salary</div>
            <div class="job-description">@job.Description</div>
        </div>
    } -->


<job-list>
    <div class="job-cardholder @(IsInF2MenuEditDoorGroupsUI ? "" : "hide")">
	@if (Jobs != null && Jobs.Count > 0)
    {
        @foreach ( var job in Jobs )
        {
		
            <div class="job-card" onclick="@(() => { AddJobToAnotherList(job); GraphJobDoorGroupButton?.Invoke(); })">
                <div class="job-title">@job.Title</div>
                <!-- <div class="job-salary">$@job.Salary</div>
                <div class="job-description">@job.Description</div>
                <div class="job-category">Category: @job.Category</div> -->
            </div>
		
        }
    }
    else
    {
        <div class="loading">Loading jobs...</div>
    }
	</div>
</job-list>


</root>



@code
{
	//Main F2Menu Doors Buttons Action Graph Logic Var
	public delegate void ActionGraphEditDoorGroup();
	[Property, Feature("Player Hud Info")]
	public ActionGraphEditDoorGroup GraphEditDoorGroup { get; set; }

	public delegate void ActionGraphBuyDoor();
	[Property, Feature("Player Hud Info")]
	public ActionGraphBuyDoor GraphBuyDoor { get; set; }

	public delegate void ActionGraphDisallowOwnership();
	[Property, Feature("Player Hud Info")]
	public ActionGraphDisallowOwnership GraphDisallowOwnership { get; set; }

	//Edit Door Group Job Name Buttons Action Graph Logic Var
	public delegate void ActionGraphJobDoorGroupButton();
	[Property, Feature("Player Hud Info")]
	public ActionGraphJobDoorGroupButton GraphJobDoorGroupButton  { get; set; }

	
	
	public bool IsSuperAdmin {get; set;}
	public bool IsDoorOwnable {get; set;}

	//UI Visability Vars
	public bool IsShowingF2Menu {get; set;}
	public bool IsInF2MenuEditDoorGroupsUI {get; set;}

    // You’ll populate this list from your .job resources
    public List<JobResource> Jobs { get; set; } = new();

	public List<JobResource> SelectedJobs { get; set; } = new();

	private void AddJobToAnotherList(JobResource job)
	{
		if (!SelectedJobs.Contains(job))
		{
			SelectedJobs.Add(job);
			Log.Info($"Added {job.Title} to SelectedJobs");
			StateHasChanged(); // refresh UI if needed
		}
	}
	
	void EditDoorGroup()
	{
	 	GraphEditDoorGroup?.Invoke();
	}

	void BuyDoor()
	{
		GraphBuyDoor?.Invoke();
	}

	void DisallowOwnership()
	{
		GraphDisallowOwnership?.Invoke();
	}

	void JobDoorGroupButton(JobResource job)
	{
	 	GraphJobDoorGroupButton?.Invoke();
	}




  protected override void OnStart()
    {
        // Subscribe to the load event so we update when jobs finish loading
        JobResource.OnJobsLoaded += RefreshJobs;

        // In case jobs were already loaded
        RefreshJobs();
    }

    private void RefreshJobs()
    {
        Jobs = JobResource.All.ToList();
        StateHasChanged(); // Force rebuild
    }








	<!-- protected override void OnUpdate()
	{
		base.OnUpdate();

		if( !IsProxy && Input.Pressed( "Slot0" ) )
		{
			Log.Info( "Pressed 9!" );
			IsShowingF2Menu = !IsShowingF2Menu;
		}
	} -->

	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// 
	///</summary>
	protected override int BuildHash() => System.HashCode.Combine( IsShowingF2Menu, Jobs?.Count ?? 0 );
}