	{
		base.OnUpdate();

		if( !IsProxy && Input.Pressed( "Slot0" ) )
		{
			Log.Info( "Pressed 9!" );
			IsShowingF2Menu = !IsShowingF2Menu;
		}
	} -->

	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// 
	///</summary>
	protected override int BuildHash() => System.HashCode.Combine( IsShowingF2Menu, IsInDoorNonOwnerMenu, IsInDoorOwnerMenu, Jobs?.Count ?? 0 );
}