	private void AddJobToAnotherList(JobResource job)
	{
		if (!SelectedJobs.Contains(job))
		{
			SelectedJobs.Add(job);
			Log.Info($"Added {job.Title} to SelectedJobs");
			StateHasChanged(); // refresh UI if needed
		}
	}
	
