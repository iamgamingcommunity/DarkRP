@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox
@using NetworkManager;

<root>
	<div class="DoorTitle">
	@DoorCustomTitle
	</div>
	
	<div class="DoorPlayerName @(PlayerWhoOwnsDoorDisplayName == "Unowned Door" ? "unowned" : "owned") @(IsDoorOwnable ? "ownable" : "notownable") @(IsDoorPurchasable ? "notpurchasable" : "purchasable")">
	@PlayerWhoOwnsDoorDisplayName
	</div>
	
	<div class="DoorBuyAmounttitle @(PlayerWhoOwnsDoorDisplayName == "Unowned Door" ? "unowned" : "owned") @(IsDoorOwnable ? "ownable" : "notownable")">
	$@PlayerWhoOwnsDoorBuyAmount
	</div>

	<div class="PlayersFriendsAddedToDoorNames @(PlayerWhoOwnsDoorDisplayName == "Unowned Door" ? "unowned" : "owned") @(IsDoorOwnable ? "ownable" : "notownable")">
	@PlayerFriendsWhoOwnDoor
	</div>
	








<job-list>
	@if (SelectedJobs != null && SelectedJobs.Count > 0)
    {
        @foreach ( var job in SelectedJobs )
        {
		
            <div class="job-card">
                <div class="job-title @(IsDoorOwnable ? "ownable" : "notownable")">@job.Title</div>
            </div>
		
        }
    }
else
</job-list>


<doorgroups-list>
	@if (SelectedDoorGroups != null && SelectedDoorGroups.Count > 0)
    {
        @foreach ( var doorgc in SelectedDoorGroups )
        {
		
            <div class="job-card">
                <div class="job-title @(IsDoorOwnable ? "ownable" : "notownable")">@doorgc.Title</div>
            </div>
		
        }
    }
    else
</doorgroups-list>


<playerfriendsaddedtodoor-list>
        @if (PlayerFriendsAddedToDoorList != null && PlayerFriendsAddedToDoorList.Count > 0)
        {
            @foreach (var player in PlayerFriendsAddedToDoorList)
            {
				var currentPlayer = player;
                <div class="job-card">
                    <div class="job-title">@currentPlayer.PlayerID</div>
                </div>
            }
        }
		else
</playerfriendsaddedtodoor-list>





</root>

@code
{
	//Edit Door Groups Selected Jobs List
	
	[Property]
	public bool HudDebugInfoOn {get; set;}
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public List<JobResource> SelectedJobs { get; set; } = new();
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public List<DoorGroupCategoryResource> SelectedDoorGroups { get; set; } = new();
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public NetworkManager NetworkManager { get; set; }
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
    public List<NetworkManager.PlayerData> PlayerDataList { get; set; } 
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public List<NetworkManager.PlayerData> PlayerFriendsAddedToDoorList {get; set;} = new();

	//Door Infomation Vars
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public string PlayerWhoOwnsDoorDisplayName {get; set;} = "Unowned Door";
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public string PlayerFriendsWhoOwnDoor {get; set;}
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public string DoorCustomTitle {get; set;}
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public float PlayerWhoOwnsDoorBuyAmount {get; set;}
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public bool DoorIsBought {get; set;}
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public bool IsDoorOwnable {get; set;}
	[Property, ShowIf ( nameof( HudDebugInfoOn ), true)]
	public bool IsDoorPurchasable {get; set;}

	/// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash() => System.HashCode.Combine( IsDoorPurchasable, PlayerFriendsWhoOwnDoor, PlayerFriendsAddedToDoorList, PlayerWhoOwnsDoorDisplayName, PlayerWhoOwnsDoorBuyAmount, IsDoorOwnable );
}